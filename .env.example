# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
FLASK_APP=run.py

# Database
DATABASE_URL=sqlite:///agrimarket.db
# For production: postgresql://user:password@localhost/agrimarket

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@agrimarket.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Cloudinary (for production file uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# App Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# SocketIO
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
# For development, leave empty to use in-memory queue
